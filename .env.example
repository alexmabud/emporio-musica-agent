# Copy to .env and fill in. Never commit .env.
#
# Quick start: set GOOGLE_API_KEY below and run `make ui`. Gemini is the default model.
# Two providers are supported; the ONLY thing that selects one is LLM_MODEL (the code does not change).

# --- Provider keys ---------------------------------------------------------------------------
# Google AI Studio (Gemini), the default. Free key at https://aistudio.google.com
# Free tier: only ~20 requests PER DAY PER MODEL.
GOOGLE_API_KEY=
# Groq: optional. Only needed to run the development model (see LLM_MODEL below) or to use a Groq
# model as a reserve. Free key at https://console.groq.com
# GROQ_API_KEY=

# --- Active model: keep EXACTLY ONE LLM_MODEL line uncommented ------------------------------------
# Reference model (final evaluation and the example conversations).
LLM_MODEL=google_genai:gemini-3.5-flash
# Development model (fast iteration, scenario by scenario):
# LLM_MODEL=groq:openai/gpt-oss-120b

LLM_TEMPERATURE=0.2

# Reserve models, tried in order when the main one fails (comma-separated, same format). Quotas are
# per model, so reserves keep the agent answering after one model's daily quota is gone. They also
# change who answers, so leave this EMPTY when you want results that belong to a single model.
# A reserve whose provider has no key (for example a groq: model with no GROQ_API_KEY) is ignored.
LLM_FALLBACK_MODELS=

# Grounding check: how many times a reply that states a price or tracking code no tool, policy or
# customer message supports is regenerated before the safe message. Each retry is one more model call.
GROUNDING_MAX_RETRIES=1

# Generated at runtime from data/*.csv (git-ignored).
DB_PATH=var/emporio.db
ESCALATIONS_PATH=var/escalations.jsonl
# 👍/👎 votes given in the Streamlit UI (e-mails and phones are masked before saving).
FEEDBACK_PATH=var/feedback.jsonl

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emporio-musica-agent
