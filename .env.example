# Copy to .env and fill in. Never commit .env.

# LLM in LangChain `init_chat_model` format: "<provider>:<model>".
# Default: Gemini through Google AI Studio (free tier). Pick a current Flash model id in AI Studio.
LLM_MODEL=google_genai:<flash-model-id>
LLM_TEMPERATURE=0.2
GOOGLE_API_KEY=

# Free alternative (also `pip install langchain-groq`): only these two lines change.
# LLM_MODEL=groq:<model-id>
# GROQ_API_KEY=

# Store timezone, injected into the system prompt ("are you open now?").
STORE_TIMEZONE=America/Campo_Grande

# Generated at runtime from data/*.csv (git-ignored).
DB_PATH=var/emporio.db
ESCALATIONS_PATH=var/escalations.jsonl

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emporio-musica-agent
