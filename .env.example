# Copy to .env and fill in. Never commit .env.

# LLM, in LangChain `init_chat_model` format: "<provider>:<model>".
# Install the matching provider package (e.g. langchain-openai) and set its API key below.
LLM_MODEL=
LLM_TEMPERATURE=0.2

# API key for the chosen provider (set the one you use).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Store timezone, injected into the system prompt ("are you open now?").
STORE_TIMEZONE=America/Campo_Grande

# Generated at runtime from data/*.csv (git-ignored).
DB_PATH=var/emporio.db
ESCALATIONS_PATH=var/escalations.jsonl

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emporio-musica-agent
