# Copy to .env and fill in. Never commit .env.
#
# Two providers are supported; the ONLY thing that selects one is LLM_MODEL (the code does not change).
# Keep both keys in .env: the one that LLM_MODEL does not use is simply ignored.

# --- Provider keys ---------------------------------------------------------------------------
# Google AI Studio (Gemini). Free tier: only ~20 requests PER DAY PER MODEL.
GOOGLE_API_KEY=
# Groq. Free tier with much larger daily limits, used for development and prompt iteration.
GROQ_API_KEY=

# --- Active model: keep EXACTLY ONE LLM_MODEL line uncommented ------------------------------------
# Reference model (final evaluation and the example conversations).
LLM_MODEL=google_genai:gemini-3.5-flash
# Development model (fast iteration, scenario by scenario):
# LLM_MODEL=groq:openai/gpt-oss-120b

LLM_TEMPERATURE=0.2

# Reserve models, tried in order when the main one fails (comma-separated, same format). Quotas are
# per model, so reserves keep the agent answering after one model's daily quota is gone. They also
# change who answers, so leave this EMPTY when you want results that belong to a single model.
LLM_FALLBACK_MODELS=

# Generated at runtime from data/*.csv (git-ignored).
DB_PATH=var/emporio.db
ESCALATIONS_PATH=var/escalations.jsonl

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=emporio-musica-agent
